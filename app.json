{
  "expo": {
    "name": "Kashi-Koi!",
    "slug": "kashi-koi",
    "version": "1.0.0",
    "scheme": "kashikoi",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["ios"],
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.kashikoi" },
    "plugins": ["expo-router", ["expo-audio", { "enableBackgroundPlayback": true }], "expo-sqlite", "expo-secure-store"],
    "experiments": { "typedRoutes": true }
  }
}
