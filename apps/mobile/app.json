{
  "expo": {
    "name": "Kashi-Koi!",
    "slug": "kashi-koi",
    "version": "1.0.0",
    "scheme": "kashikoi",
    "orientation": "portrait",
    "icon": "./assets/sidestore-icon.png",
    "userInterfaceStyle": "dark",
    "platforms": ["ios"],
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.kashikoi" },
    "plugins": [
      "expo-router",
      ["expo-audio", { "enableBackgroundPlayback": true }],
      "expo-sqlite",
      "expo-secure-store",
      ["expo-build-properties", { "ios": { "deploymentTarget": "26.0" } }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
