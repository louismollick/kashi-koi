{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // Generated: routeTree.gen.ts by the TanStack Router plugin, tokens.css by packages/design (kept byte-identical by a test).
  "files": { "ignoreUnknown": true, "includes": ["**", "!**/routeTree.gen.ts", "!apps/web/src/styles/tokens.css"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "html": { "formatter": { "enabled": true } },
  // The web app's CSS uses Tailwind v4 directives (@theme, @layer).
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "enabled": false },
  "overrides": [
    {
      "includes": [
        "apps/mobile/**/*.ts",
        "apps/mobile/**/*.tsx",
        "apps/web/**/*.ts",
        "apps/web/**/*.tsx",
        "packages/core/**/*.ts",
        "packages/design/**/*.ts"
      ],
      "linter": {
        "rules": {
          // Existing indexed lookups assert invariants already covered by app tests.
          "style": { "noNonNullAssertion": "off" }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/**/*.tsx"],
      "linter": {
        "rules": {
          // Changing effect triggers or occurrence keys would change app behaviour.
          "correctness": { "useExhaustiveDependencies": "off" },
          // forEach ignores these callbacks' return values.
          "suspicious": { "noArrayIndexKey": "off", "useIterableCallbackReturn": "off" }
        }
      }
    },
    {
      "includes": ["apps/mobile/assets/icons/*.svg"],
      "linter": {
        "rules": {
          // The native controls provide accessible labels for these decorative icons.
          "a11y": { "noSvgWithoutTitle": "off" }
        }
      }
    },
    {
      "includes": ["mockups/**"],
      "linter": {
        "rules": {
          // Preserve archived mockup navigation, font choices and cascade ordering.
          "a11y": { "useValidAnchor": "off", "useGenericFontNames": "off", "noSvgWithoutTitle": "off" },
          "style": { "noDescendingSpecificity": "off" },
          "complexity": { "noImportantStyles": "off" },
          // Keep the seeded generator and callbacks whose results are ignored.
          "suspicious": { "noAssignInExpressions": "off", "useIterableCallbackReturn": "off" }
        }
      }
    }
  ]
}
